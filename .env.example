# cp .env.example .env 후 값을 채운다. .env는 git에 올라가지 않는다.
# 서울 열린데이터광장(data.seoul.go.kr) → "실시간 지하철 인증키" (일반 인증키로는 호출되지 않음)
SEOUL_SUBWAY_KEY=

# 배포(compose.prod.yaml)에서만 쓴다. 개발(bootRun)은 compose.yaml의 기본값을 쓴다.
DB_PASSWORD=
DB_ROOT_PASSWORD=
# 배포 https 주소(Caddy가 인증서를 받음). 고정 IP를 쓰는 무료 주소면 IP의 점을 -로: 13-237-105-89.sslip.io
DOMAIN=
